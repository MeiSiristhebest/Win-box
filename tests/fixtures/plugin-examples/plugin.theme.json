{
  "manifestVersion": 1,
  "id": "my-theme-plugin",
  "name": "我的皮肤插件",
  "version": "1.0.0",
  "apiVersion": "1.x",
  "kind": "asset",
  "author": "your-name",
  "license": "MIT",
  "homepage": "https://github.com/you/repo",
  "description": "一套声明式皮肤：只给令牌 + 布局声明，不写任何 CSS",
  "permissions": [],
  "contributes": [
    {
      "type": "theme",
      "id": "sakura",
      "label": "🌸 樱花",
      "base": "dark",
      "tokens": {
        "--surface-0": "#120d12",
        "--surface-1": "rgba(28, 20, 26, .85)",
        "--surface-2": "rgba(38, 28, 35, .8)",
        "--surface-3": "rgba(48, 36, 45, .85)",
        "--surface-glass": "rgba(18, 13, 18, .9)",
        "--accent": "#e879a6",
        "--accent-strong": "#f18cb4",
        "--accent-container": "#e879a6",
        "--accent-soft": "rgba(232, 121, 166, .16)",
        "--on-accent": "#1a1116",
        "--accent-2": "#8ad6c8",
        "--text": "#f6eef3",
        "--text-dim": "#c3a9b6",
        "--text-faint": "#8e7681",
        "--border": "#432f3b",
        "--border-soft": "rgba(255, 255, 255, .1)",
        "--hairline": "rgba(255, 255, 255, .08)",
        "--danger": "#ff6b8a",
        "--warn": "#ffc25e",
        "--success": "#63e6be",
        "--info": "#e879a6",
        "--radius": "14px",
        "--radius-sm": "8px",
        "--radius-lg": "20px",
        "--shadow": "0 8px 24px rgba(0, 0, 0, .45)",
        "--shadow-lg": "0 18px 48px rgba(0, 0, 0, .55)",
        "--ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
        "--ease-enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
        "--ease-exit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
        "--ease-spring": "cubic-bezier(0.31, 0.94, 0.34, 1)",
        "--dur-instant": "100ms",
        "--dur-quick": "150ms",
        "--dur-state": "200ms",
        "--dur-panel": "280ms",
        "--dur-page": "440ms",
        "--fs-xs": "11px",
        "--fs-sm": "12px",
        "--fs-md": "13.5px",
        "--fs-lg": "15px",
        "--fs-xl": "18px",
        "--fs-2xl": "22px"
      },
      "layout": {
        "shell": "topbar",
        "detailStyle": "cinema",
        "discoverStyle": "shelf"
      }
    }
  ]
}
