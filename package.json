{
  "name": "win-box",
  "version": "1.27.1",
  "private": true,
  "description": "Windows 桌面媒体源管理与播放工具，支持多份配置导入和合并",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.12.0",
      "onFail": "download"
    }
  },
  "main": "dist/main.cjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:release-assets": "node --test --test-isolation=none scripts/verify-release-assets.check.mjs scripts/build-jvm-stubs.check.mjs",
    "build:jvm-stubs": "node scripts/build-jvm-stubs.mjs",
    "test:package-app-policy": "node --test --test-isolation=none scripts/package-app-path-policy.check.mjs scripts/package-app-runtime-closure.check.mjs scripts/package-app-size-report.check.mjs scripts/package-locales.check.mjs",
    "check:package-app-runtime-closure": "node scripts/check-package-app-runtime-closure.mjs",
    "test:subscription-import": "node --experimental-strip-types --test --test-isolation=none scripts/verify-subscription-import.check.mjs",
    "lint": "oxlint --deny-warnings src scripts tests && node scripts/architecture-boundaries.mjs && pnpm run lint:ui",
    "lint:ui": "oxlint --react-plugin --react-perf-plugin --deny-warnings src/renderer && oxlint --jsx-a11y-plugin --deny-warnings src/renderer",
    "typecheck": "pnpm run typecheck:main && pnpm run typecheck:renderer && pnpm run typecheck:test",
    "typecheck:main": "tsc --noEmit -p tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "architecture:check": "node scripts/architecture-boundaries.mjs",
    "dev": "concurrently -k -n vite,main,electron -c green,blue,magenta \"vite\" \"node scripts/build-main.mjs --watch\" \"wait-on tcp:5173 && node scripts/dev-electron.mjs\"",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "start": "electron .",
    "pack": "pnpm run build && node scripts/package-app.mjs",
    "dist": "node scripts/build-release.mjs",
    "release:upload": "node scripts/upload-release.mjs",
    "test:dev": "node --test scripts/dev-electron.check.mjs",
    "build:native-bridge": "node scripts/gen-native-bridge.mjs",
    "test:native-bridge": "node --test scripts/verify-native-bridge.check.mjs",
    "test:installer": "node --test scripts/installer-script.check.mjs",
    "acceptance:install": "node scripts/verify-installation.mjs",
    "acceptance:playback": "node scripts/verify-playback.mjs",
    "test:acceptance-tools": "node --test --test-isolation=none scripts/webm-fixture.check.mjs scripts/source-acceptance.check.mjs scripts/verify-playback.check.mjs"
  },
  "author": "Win-Box",
  "license": "MIT",
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/packager": "^20.3.0",
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.341",
    "@nsis/release-data": "^0.1.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@zip.js/zip.js": "^2.23.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.6",
    "crypto-es": "^3.1.3",
    "electron": "44.8.0",
    "esbuild": "^0.28.2",
    "happy-dom": "21.0.3",
    "hls.js": "^1.7.3",
    "mpegts.js": "^1.8.2",
    "oxlint": "^1.88.0",
    "playwright-core": "1.64.1",
    "pinyin-match": "^1.2.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.4",
    "resedit": "^3.1.0",
    "typescript": "^7.0.2",
    "undici": "^8.12.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "7z-wasm": "1.2.0",
    "@babel/core": "^8.0.7",
    "@babel/parser": "^8.0.7",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "fast-xml-parser": "^5.11.2",
    "iconv-lite": "^0.7.3",
    "node-unrar-js": "2.0.2"
  }
}
